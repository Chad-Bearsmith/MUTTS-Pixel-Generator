# Do not convert binary Unity/WebAssembly files to text or alter their line endings.
*.wasm binary
*.data binary
*.npz binary
*.npy binary
*.png binary
*.ico binary
*.zip binary
*.rgba binary
*.exe binary
*.js text eol=lf
*.py text eol=lf
*.go text eol=lf
*.json text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.html text eol=lf
*.css text eol=lf
